SITE_ORIGIN=https://hasankokce.com
ADMIN_EMAIL=hasan.seyfi.kokce@hotmail.com
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
DATA_DIR=./data
PORT=3000
TRUST_PROXY=0

# Hostinger mailbox credentials, stored only on the server
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@hasankokce.com
SMTP_PASSWORD=

# With a local reverse proxy, bind to loopback and trust its sanitized headers.
# Use localhost, not 127.0.0.1: with 127.0.0.1 Next.js treats the /en rewrite as an external fetch and English pages break.
BIND_HOST=localhost
